{
  "name": "game-graph",
  "version": "0.6.0",
  "private": true,
  "description": "独立的游戏规则因果与包含关系图分析工具",
  "type": "module",
  "bin": {
    "game-graph": "src/server/cli.mjs"
  },
  "files": [
    "src/",
    "schemas/",
    "docs/",
    "examples/",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/chanyuenpang/game-graph.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node src/server/cli.mjs serve",
    "validate": "node src/server/cli.mjs validate",
    "test": "node --test",
    "check": "node scripts/check.mjs",
    "check:package": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "elkjs": "^0.12.0",
    "webcola": "^3.4.0"
  }
}
