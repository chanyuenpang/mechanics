{
  "name": "game-graph",
  "version": "0.7.2",
  "private": false,
  "description": "独立的游戏规则因果与包含关系图分析工具",
  "type": "module",
  "bin": {
    "game-graph": "src/server/cli.mjs"
  },
  "files": [
    "src/",
    "workspace-tools/",
    "schemas/",
    "skills/",
    "docs/",
    "examples/",
    "!examples/card-game/.game-graph/.game-graph.lock",
    "!examples/**/.agents/",
    "!examples/**/.rule-text-backup-*/",
    "!examples/**/game-mechanics/",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chanyuenpang/game-graph.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node src/server/cli.mjs web",
    "validate": "node src/server/cli.mjs validate",
    "test": "node --test",
    "check": "node scripts/check.mjs",
    "check:package": "node scripts/check-package.mjs",
    "release:check": "npm run check && npm run check:package"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "elkjs": "^0.12.0",
    "libavoid-js": "0.5.0-beta.5",
    "webcola": "^3.4.0"
  }
}
