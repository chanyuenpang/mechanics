{
  "name": "@veewo/mechanics",
  "version": "0.7.3",
  "private": false,
  "description": "Mechanics：规则、概念与关系解释工具",
  "type": "module",
  "bin": {
    "mech": "src/server/cli.mjs"
  },
  "files": [
    "src/",
    "workspace-tools/",
    "schemas/",
    "skills/",
    "docs/",
    "examples/",
    "!examples/card-game/.mechanics/.mechanics.lock",
    "!examples/**/.agents/",
    "!examples/**/.rule-text-backup-*/",
    "!examples/**/mechanics/",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chanyuenpang/mechanics.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node src/server/cli.mjs web",
    "validate": "node src/server/cli.mjs validate",
    "test": "node --test",
    "check": "node scripts/check.mjs",
    "check:package": "node scripts/check-package.mjs",
    "cleanup:legacy-skills": "node scripts/cleanup-legacy-project-skills.mjs",
    "release:check": "npm run check && npm run check:package"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "elkjs": "^0.12.0",
    "libavoid-js": "0.5.0-beta.5",
    "webcola": "^3.4.0"
  }
}
