{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:mechanics-tools:protocol:12",
  "title": "Mechanics 工作区 v12、机制 v7、定义 v7、规则库 v1、视图 v4",
  "oneOf": [
    {
      "$ref": "#/definitions/workspace"
    },
    {
      "$ref": "#/definitions/definitionGraph"
    },
    {
      "$ref": "#/definitions/ruleRegistry"
    },
    {
      "$ref": "#/definitions/mechanic"
    },
    {
      "$ref": "#/definitions/view"
    }
  ],
  "definitions": {
    "id": {
      "type": "string",
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "tagId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/id"
      }
    },
    "relativePath": {
      "type": "string",
      "minLength": 6,
      "maxLength": 512,
      "pattern": "^[^:\u0000-\u001f<>\"|?*]+\\.json$"
    },
    "relativeDirectory": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^:\u0000-\u001f<>\"|?*]+$"
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        },
        "y": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        }
      }
    },
    "positions": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/id"
      },
      "additionalProperties": {
        "$ref": "#/definitions/position"
      }
    },
    "nodeColors": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/id"
      },
      "additionalProperties": {
        "enum": [
          "#E4EDF5",
          "#EAE7F2",
          "#F0E8EF",
          "#E8F0EE",
          "#EEEDE5",
          "#E9EEF0",
          "#F1EAE4",
          "#E3EEF9",
          "#ECE6F7",
          "#F8E7EE",
          "#E2F1EB",
          "#F5EEDC",
          "#E1F0F3",
          "#F8E8DF",
          "#D5E8F7",
          "#E5DCF4",
          "#F5DDE7",
          "#D2EDE2",
          "#F4E2BC",
          "#D2EAEE",
          "#F5DCD2"
        ]
      }
    },
    "nodeStyles": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/id"
      },
      "additionalProperties": {
        "enum": [
          "solid",
          "transparent-dashed"
        ]
      }
    },
    "routePath": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/definitions/position"
      }
    },
    "routeCache": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "geometryKey",
        "paths"
      ],
      "properties": {
        "geometryKey": {
          "type": "string",
          "maxLength": 1048576
        },
        "paths": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/routePath"
          }
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "graphIds",
        "collapsedNodeIds",
        "positions"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "$ref": "#/definitions/text"
        },
        "graphIds": {
          "$ref": "#/definitions/ids"
        },
        "collapsedNodeIds": {
          "$ref": "#/definitions/ids"
        },
        "positions": {
          "$ref": "#/definitions/positions"
        },
        "routeCache": {
          "$ref": "#/definitions/routeCache"
        }
      }
    },
    "inlineView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graphIds",
        "activeLayerId",
        "collapsedNodeIds",
        "positions"
      ],
      "properties": {
        "graphIds": {
          "$ref": "#/definitions/ids"
        },
        "activeLayerId": {
          "anyOf": [
            {
              "$ref": "#/definitions/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "collapsedNodeIds": {
          "$ref": "#/definitions/ids"
        },
        "positions": {
          "$ref": "#/definitions/positions"
        },
        "routeCache": {
          "$ref": "#/definitions/routeCache"
        }
      }
    },
    "viewReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "viewId"
      ],
      "properties": {
        "viewId": {
          "$ref": "#/definitions/id"
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "name",
        "definitions",
        "rules",
        "compositions"
      ],
      "properties": {
        "schemaVersion": {
          "enum": [
            12
          ]
        },
        "kind": {
          "const": "workspace"
        },
        "id": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "$ref": "#/definitions/text"
        },
        "definitions": {
          "$ref": "#/definitions/relativePath"
        },
        "rules": {
          "$ref": "#/definitions/relativePath"
        },
        "agentExportPath": {
          "$ref": "#/definitions/relativeDirectory"
        },
        "exportSelections": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/exportSelection"
          }
        },
        "compositions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/composition"
          }
        },
        "lastView": {
          "oneOf": [
            {
              "$ref": "#/definitions/inlineView"
            },
            {
              "$ref": "#/definitions/viewReference"
            }
          ]
        }
      }
    },
    "exportSelection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "folder"],
          "properties": {
            "kind": { "const": "folder" },
            "folder": { "$ref": "#/definitions/relativeDirectory" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "mechanicId"],
          "properties": {
            "kind": { "const": "mechanic" },
            "mechanicId": { "$ref": "#/definitions/id" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "viewId"],
          "properties": {
            "kind": { "const": "view" },
            "viewId": { "$ref": "#/definitions/id" }
          }
        }
      ]
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "workspaceId",
        "id",
        "name",
        "mechanicRegistrations",
        "focusNodeIds",
        "pinnedRuleIds",
        "collapsedNodeIds",
        "positions",
        "structuralPresentation"
      ],
      "properties": {
        "schemaVersion": {
          "const": 4
        },
        "kind": {
          "const": "view"
        },
        "workspaceId": {
          "$ref": "#/definitions/id"
        },
        "id": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "$ref": "#/definitions/text"
        },
        "mechanicRegistrations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mechanicId",
              "visible"
            ],
            "properties": {
              "mechanicId": {
                "$ref": "#/definitions/id"
              },
              "visible": {
                "type": "boolean"
              }
            }
          }
        },
        "focusNodeIds": {
          "$ref": "#/definitions/ids"
        },
        "pinnedRuleIds": {
          "$ref": "#/definitions/ids"
        },
        "collapsedNodeIds": {
          "$ref": "#/definitions/ids"
        },
        "positions": {
          "$ref": "#/definitions/positions"
        },
        "nodeColors": {
          "$ref": "#/definitions/nodeColors"
        },
        "nodeStyles": {
          "$ref": "#/definitions/nodeStyles"
        },
        "structuralPresentation": {
          "enum": [
            "line",
            "badge"
          ]
        },
        "projectionPositions": {
          "$ref": "#/definitions/projectionPositions"
        },
        "routeCache": {
          "$ref": "#/definitions/routeCache"
        }
      }
    },
    "qualifierValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "conceptId"
          ],
          "properties": {
            "kind": {
              "const": "concept"
            },
            "conceptId": {
              "$ref": "#/definitions/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "literal"
            },
            "value": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      ]
    },
    "qualifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "$ref": "#/definitions/id"
        },
        "value": {
          "$ref": "#/definitions/qualifierValue"
        }
      }
    },
    "nodeFields": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "label": {
          "$ref": "#/definitions/text"
        },
        "description": {
          "$ref": "#/definitions/text"
        },
        "customData": {
          "$ref": "#/definitions/customData"
        },
        "agentLocked": {
          "type": "boolean"
        },
        "tagIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/tagId"
          }
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "baseConceptId": {
          "$ref": "#/definitions/id"
        },
        "qualifiers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/qualifier"
          }
        }
      }
    },
    "node": {
      "$ref": "#/definitions/baseNode"
    },
    "customData": {
      "type": "string",
      "maxLength": 16000
    },
    "baseNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "description",
        "agentLocked"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "label": {
          "$ref": "#/definitions/text"
        },
        "description": {
          "$ref": "#/definitions/text"
        },
        "customData": {
          "$ref": "#/definitions/customData"
        },
        "agentLocked": {
          "type": "boolean"
        },
        "tagIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/tagId"
          }
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        }
      }
    },
    "qualifiedNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "description",
        "agentLocked",
        "baseConceptId",
        "qualifiers"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "label": {
          "$ref": "#/definitions/text"
        },
        "description": {
          "$ref": "#/definitions/text"
        },
        "customData": {
          "$ref": "#/definitions/customData"
        },
        "agentLocked": {
          "type": "boolean"
        },
        "tagIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/tagId"
          }
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "baseConceptId": {
          "$ref": "#/definitions/id"
        },
        "qualifiers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/qualifier"
          }
        }
      }
    },
    "tagDefinition": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "displayName", "color"],
      "properties": { "id": { "$ref": "#/definitions/tagId" }, "displayName": { "$ref": "#/definitions/text" }, "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" } }
    },
    "definitionGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "workspaceId",
        "nodes",
        "positions"
      ],
      "properties": {
        "schemaVersion": {
          "enum": [
            7
          ]
        },
        "kind": {
          "const": "definitions"
        },
        "workspaceId": {
          "$ref": "#/definitions/id"
        },
        "tagDefinitions": { "type": "array", "items": { "$ref": "#/definitions/tagDefinition" } },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/node"
          }
        },
    "positions": {
          "$ref": "#/definitions/positions"
        }
      }
    },
    "projectionPositions": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/position"
      }
    },
    "ruleRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "workspaceId", "rules"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "rules" },
        "workspaceId": { "$ref": "#/definitions/id" },
        "rules": { "type": "array", "items": { "$ref": "#/definitions/edge" } },
        "retentionBindings": { "type": "array", "items": { "$ref": "#/definitions/retentionBinding" } }
      }
    },
    "retentionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mechanismConceptId", "resourceConceptId", "capConceptId"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "mechanismConceptId": { "$ref": "#/definitions/id" },
        "resourceConceptId": { "$ref": "#/definitions/id" },
        "capConceptId": { "$ref": "#/definitions/id" }
      }
    },
    "inheritance": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "none"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "endpoints",
            "maxSpecializationHops"
          ],
          "properties": {
            "mode": {
              "const": "specializeEndpoint"
            },
            "endpoints": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "source",
                  "target"
                ]
              }
            },
            "maxSpecializationHops": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            }
          }
        }
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "target",
        "relation"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "source": {
          "$ref": "#/definitions/id"
        },
        "target": {
          "$ref": "#/definitions/id"
        },
        "sourceQualifiers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/qualifier"
          }
        },
        "targetQualifiers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/qualifier"
          }
        },
        "relation": {
          "enum": [
            "influence",
            "specializes"
          ]
        },
        "sign": {
          "enum": [
            1,
            -1,
            "random"
          ]
        },
        "inheritance": {
          "$ref": "#/definitions/inheritance"
        },
        "ruleText": {
          "type": "string",
          "maxLength": 8000
        },
        "customData": {
          "$ref": "#/definitions/customData"
        }
      },
      "oneOf": [
        {
          "properties": {
            "relation": {
              "const": "influence"
            }
          },
          "required": [
            "sign",
            "inheritance"
          ]
        },
        {
          "properties": {
            "relation": {
              "const": "specializes"
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "sign"
                ]
              },
              {
                "required": [
                  "inheritance"
                ]
              },
              {
                "required": [
                  "sourceQualifiers"
                ]
              },
              {
                "required": [
                  "targetQualifiers"
                ]
              }
            ]
          }
        }
      ]
    },
    "mechanic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "workspaceId",
        "id",
        "name",
        "scope",
        "focusNodeIds",
        "pinnedRuleIds",
        "positions"
      ],
      "properties": {
        "schemaVersion": {
          "enum": [
            7
          ]
        },
        "kind": {
          "const": "mechanic"
        },
        "workspaceId": {
          "$ref": "#/definitions/id"
        },
        "id": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "$ref": "#/definitions/text"
        },
        "scope": {
          "$ref": "#/definitions/text"
        },
        "ruleSelection": {
          "const": "explicit"
        },
        "focusNodeIds": {
          "$ref": "#/definitions/ids"
        },
        "pinnedRuleIds": {
          "$ref": "#/definitions/ids"
        },
        "positions": {
          "$ref": "#/definitions/positions"
        },
        "nodeColors": {
          "$ref": "#/definitions/nodeColors"
        },
        "nodeStyles": {
          "$ref": "#/definitions/nodeStyles"
        },
        "projectionPositions": {
          "$ref": "#/definitions/projectionPositions"
        },
        "routeCache": {
          "$ref": "#/definitions/routeCache"
        }
      }
    }
  }
}
