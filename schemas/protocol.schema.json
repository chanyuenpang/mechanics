{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:game-graph:protocol:4",
  "title": "Game-Graph 工作区 v4、机制与定义 v1、视图 v2",
  "oneOf": [
    { "$ref": "#/definitions/workspace" },
    { "$ref": "#/definitions/definitionGraph" },
    { "$ref": "#/definitions/mechanic" },
    { "$ref": "#/definitions/view" }
  ],
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,95}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 8000 },
    "ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/id" } },
    "relativePath": { "type": "string", "minLength": 6, "maxLength": 512, "pattern": "^[^\\\\:\\u0000-\\u001f<>\"|?*]+\\.json$" },
    "position": {
      "type": "object", "additionalProperties": false, "required": ["x", "y"],
      "properties": { "x": { "type": "number", "minimum": -100000, "maximum": 100000 }, "y": { "type": "number", "minimum": -100000, "maximum": 100000 } }
    },
    "positions": { "type": "object", "propertyNames": { "$ref": "#/definitions/id" }, "additionalProperties": { "$ref": "#/definitions/position" } },
    "composition": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "graphIds", "collapsedNodeIds", "positions"],
      "properties": {
        "id": { "$ref": "#/definitions/id" }, "name": { "$ref": "#/definitions/text" },
        "graphIds": { "$ref": "#/definitions/ids" }, "collapsedNodeIds": { "$ref": "#/definitions/ids" }, "positions": { "$ref": "#/definitions/positions" }
      }
    },
    "inlineView": {
      "type": "object", "additionalProperties": false, "required": ["graphIds", "activeLayerId", "collapsedNodeIds", "positions"],
      "properties": {
        "graphIds": { "$ref": "#/definitions/ids" },
        "activeLayerId": { "anyOf": [{ "$ref": "#/definitions/id" }, { "type": "null" }] },
        "collapsedNodeIds": { "$ref": "#/definitions/ids" }, "positions": { "$ref": "#/definitions/positions" }
      }
    },
    "workspace": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion", "kind", "id", "name", "definitions", "compositions"],
      "properties": {
        "schemaVersion": { "const": 4 }, "kind": { "const": "workspace" },
        "id": { "$ref": "#/definitions/id" }, "name": { "$ref": "#/definitions/text" },
        "definitions": { "$ref": "#/definitions/relativePath" },
        "compositions": { "type": "array", "items": { "$ref": "#/definitions/composition" } },
        "lastView": { "oneOf": [{ "$ref": "#/definitions/inlineView" }, { "$ref": "#/definitions/viewReference" }] }
      }
    },
    "viewReference": {
      "type": "object", "additionalProperties": false, "required": ["viewId"],
      "properties": { "viewId": { "$ref": "#/definitions/id" } }
    },
    "view": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "kind", "workspaceId", "id", "name", "mechanicRegistrations", "collapsedNodeIds", "positions"],
      "properties": {
        "schemaVersion": { "const": 2 }, "kind": { "const": "view" }, "workspaceId": { "$ref": "#/definitions/id" },
        "id": { "$ref": "#/definitions/id" }, "name": { "$ref": "#/definitions/text" },
        "mechanicRegistrations": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["mechanicId", "visible"],
            "properties": { "mechanicId": { "$ref": "#/definitions/id" }, "visible": { "type": "boolean" } }
          }
        },
        "collapsedNodeIds": { "$ref": "#/definitions/ids" }, "positions": { "$ref": "#/definitions/positions" }
      }
    },
    "node": {
      "type": "object", "additionalProperties": false, "required": ["id", "label", "description", "increaseMeaning"],
      "properties": {
        "id": { "$ref": "#/definitions/id" }, "label": { "$ref": "#/definitions/text" },
        "description": { "$ref": "#/definitions/text" }, "increaseMeaning": { "$ref": "#/definitions/text" },
        "tags": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/text" } }
      }
    },
    "definitionGraph": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion", "kind", "workspaceId", "nodes", "positions"],
      "properties": {
        "schemaVersion": { "const": 1 }, "kind": { "const": "definitions" }, "workspaceId": { "$ref": "#/definitions/id" },
        "nodes": { "type": "array", "items": { "$ref": "#/definitions/node" } }, "positions": { "$ref": "#/definitions/positions" }
      }
    },
    "edge": {
      "type": "object", "additionalProperties": false, "required": ["id", "source", "target", "relation", "condition", "note"],
      "properties": {
        "id": { "$ref": "#/definitions/id" }, "source": { "$ref": "#/definitions/id" }, "target": { "$ref": "#/definitions/id" },
        "relation": { "enum": ["influence", "contains"] }, "sign": { "enum": [1, -1] },
        "condition": { "type": "string", "maxLength": 8000 }, "note": { "type": "string", "maxLength": 8000 }
      },
      "if": { "properties": { "relation": { "const": "influence" } } },
      "then": { "properties": { "sign": {} }, "required": ["sign"] }, "else": { "properties": { "sign": false } }
    },
    "mechanic": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion", "kind", "workspaceId", "id", "name", "scope", "nodeIds", "edges", "positions"],
      "properties": {
        "schemaVersion": { "const": 1 }, "kind": { "const": "mechanic" }, "workspaceId": { "$ref": "#/definitions/id" },
        "id": { "$ref": "#/definitions/id" }, "name": { "$ref": "#/definitions/text" }, "scope": { "$ref": "#/definitions/text" },
        "nodeIds": { "$ref": "#/definitions/ids" }, "edges": { "type": "array", "items": { "$ref": "#/definitions/edge" } },
        "positions": { "$ref": "#/definitions/positions" }
      }
    }
  }
}
