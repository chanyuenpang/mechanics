{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:game-rule-analyzer:legacy-workspace:2",
  "title": "仅供显式迁移的工作区 v2",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "kind", "id", "name", "definitions", "compositions"],
  "properties": {
    "schemaVersion": { "const": 2 }, "kind": { "const": "workspace" },
    "id": { "$ref": "urn:game-rule-analyzer:protocol:3#/definitions/id" },
    "name": { "$ref": "urn:game-rule-analyzer:protocol:3#/definitions/text" },
    "definitions": { "$ref": "urn:game-rule-analyzer:protocol:3#/definitions/relativePath" },
    "compositions": { "type": "array", "items": { "$ref": "urn:game-rule-analyzer:protocol:3#/definitions/composition" } },
    "lastView": { "$ref": "urn:game-rule-analyzer:protocol:3#/definitions/inlineView" }
  }
}
